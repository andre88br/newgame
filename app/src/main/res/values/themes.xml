<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tema só da janela: define a cor que aparece entre o toque no ícone e o primeiro
      quadro desenhado pelo Compose. Sem ela, o app pisca branco ao abrir no tema escuro.
      Toda a aparência de verdade está em ui/theme/Theme.kt.

      O pai é android:Theme.Material.Light.NoActionBar, do próprio sistema, para não
      precisar da biblioteca XML do Material — que seria mais uma dependência.
    -->
    <style name="Theme.Newgame" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
    </style>

    <!--
      Tela de abertura.

      No Android 12 e acima o sistema mostra uma sozinho, quer o app peça ou não. Esta
      declaração serve para duas coisas: escolher o que aparece nela em vez de aceitar o
      padrão, e — o motivo de valer uma dependência — **fazer o mesmo do Android 7 ao 11**,
      onde não existe tela de abertura nenhuma e o app abriria num retângulo liso.

      `postSplashScreenTheme` é o tema que entra assim que a abertura sai; sem ele a janela
      ficaria com o fundo da abertura por baixo do app inteiro.
    -->
    <style name="Theme.Newgame.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Newgame</item>
    </style>
</resources>
